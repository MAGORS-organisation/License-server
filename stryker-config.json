{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Mutators/stryker-config-schema.json",
  "stryker-config": {
    "solution": "Achilles.slnx",
    "project": "Achilles.Crypto.csproj",
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 80
    },
    "mutation-level": "Standard",
    "concurrency": 4,
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "test-runner": "dotnet",
    "coverage-analysis": "perTest",
    "ignore-mutations": [
      "linq",
      "regex"
    ],
    "output-path": "StrykerOutput"
  }
}
