# Stage 1: Build & Publish
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy configuration files and csproj files for layer caching
COPY Directory.Build.props Directory.Packages.props ./
COPY src/Achilles.Crypto/Achilles.Crypto.csproj src/Achilles.Crypto/
COPY src/Achilles.Format/Achilles.Format.csproj src/Achilles.Format/
COPY src/Achilles.Protocol/Achilles.Protocol.csproj src/Achilles.Protocol/
COPY src/Achilles.Domain/Achilles.Domain.csproj src/Achilles.Domain/
COPY src/Achilles.Data/Achilles.Data.csproj src/Achilles.Data/
COPY src/Achilles.ControlPlane/Achilles.ControlPlane.csproj src/Achilles.ControlPlane/

RUN dotnet restore src/Achilles.ControlPlane/Achilles.ControlPlane.csproj

# Copy source files
COPY src/Achilles.Crypto/ src/Achilles.Crypto/
COPY src/Achilles.Format/ src/Achilles.Format/
COPY src/Achilles.Protocol/ src/Achilles.Protocol/
COPY src/Achilles.Domain/ src/Achilles.Domain/
COPY src/Achilles.Data/ src/Achilles.Data/
COPY src/Achilles.ControlPlane/ src/Achilles.ControlPlane/

RUN dotnet publish src/Achilles.ControlPlane/Achilles.ControlPlane.csproj \
    -c Release \
    -o /out \
    --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Run as non-root user
USER $APP_UID

COPY --from=build /out .

ENV ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production

EXPOSE 8080

ENTRYPOINT ["dotnet", "Achilles.ControlPlane.dll"]
