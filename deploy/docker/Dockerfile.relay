# Stage 1: Build & Publish
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy configuration files and csproj files for layer caching
COPY Directory.Build.props Directory.Packages.props ./
COPY src/Achilles.Crypto/Achilles.Crypto.csproj src/Achilles.Crypto/
COPY src/Achilles.Format/Achilles.Format.csproj src/Achilles.Format/
COPY src/Achilles.Protocol/Achilles.Protocol.csproj src/Achilles.Protocol/
COPY src/Achilles.Domain/Achilles.Domain.csproj src/Achilles.Domain/
COPY src/Achilles.Relay/Achilles.Relay.csproj src/Achilles.Relay/

RUN dotnet restore src/Achilles.Relay/Achilles.Relay.csproj

# Copy source files
COPY src/Achilles.Crypto/ src/Achilles.Crypto/
COPY src/Achilles.Format/ src/Achilles.Format/
COPY src/Achilles.Protocol/ src/Achilles.Protocol/
COPY src/Achilles.Domain/ src/Achilles.Domain/
COPY src/Achilles.Relay/ src/Achilles.Relay/

RUN dotnet publish src/Achilles.Relay/Achilles.Relay.csproj \
    -c Release \
    -o /out \
    --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Create directory for sqlite database with write permissions
RUN mkdir -p /app/data && chown -R $APP_UID:$APP_UID /app/data

USER $APP_UID

COPY --from=build /out .

ENV ASPNETCORE_HTTP_PORTS=8081 \
    ASPNETCORE_ENVIRONMENT=Production \
    Database__ConnectionString="Data Source=/app/data/achilles-relay.db"

EXPOSE 8081

ENTRYPOINT ["dotnet", "Achilles.Relay.dll"]
